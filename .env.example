APP_NAME=Kosway
AI_ASSISTANT_NAME=Moon
BRAND_LOGO_URL=/brand/kosway-mark.svg
VITE_APP_NAME=Kosway
VITE_AI_ASSISTANT_NAME=Moon
VITE_BRAND_LOGO_URL=/brand/kosway-mark.svg
VITE_API_BASE_URL=http://localhost:8000
APP_ENV=development
API_V1_PREFIX=/api/v1
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-secret-before-use
DATABASE_URL=postgresql+psycopg://agentdesk:agentdesk_dev_only@127.0.0.1:5433/agentdesk
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Phase 3 — Integration settings (optional in local development)
#
# The four variables below are NOT required to start the application or run
# tests that do not touch the Gmail integration.  Leave them commented out
# during normal development.
#
# All four MUST be set (via environment or a secrets manager) in production
# before the Gmail integration is enabled for real users.
# =============================================================================

# --- Google OAuth 2.0 (from Google Cloud Console) ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-replace-with-real-secret

# The redirect URI must be registered in GCP Console exactly as written here.
# Local development:
#   GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
# Production (must use HTTPS):
#   GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/integrations/google/callback

# --- Credential encryption key ---
# Fernet symmetric key for encrypting OAuth tokens at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The output is a 44-character url-safe base64 string.
# NEVER commit a real key. NEVER reuse this key for anything else.
# INTEGRATION_ENCRYPTION_KEY=replace-with-output-of-Fernet.generate_key

# --- Gmail intelligence provider (backend only) ---
AI_PROVIDER=gemini
# Optional override for the selected provider's model ID.
# AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Gemini (default provider); get a key from Google AI Studio.
# GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# To use Grok instead, set AI_PROVIDER=xai and provide an xAI API key.
# XAI_API_KEY=replace-with-xai-api-key
XAI_MODEL=grok-4.7
# Existing XAI_TIMEOUT_SECONDS and XAI_MAX_RETRIES settings remain supported.

# Gmail sync scans messages received within this window (1–365 days).
GMAIL_SYNC_WINDOW_DAYS=14
